{
  "name": "auto-gitmoji-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "Repository root for Auto Gitmoji & Docs. The extension lives in ./extension.",
  "license": "MIT",
  "author": {
    "name": "KueTech Digital",
    "url": "https://kuetech.at"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FloKuersten/Gitmoji.git"
  },
  "scripts": {
    "build": "npm --prefix extension run build",
    "watch": "npm --prefix extension run watch",
    "lint": "npm --prefix extension run lint",
    "format": "npm --prefix extension run format",
    "typecheck": "npm --prefix extension run typecheck",
    "test": "npm --prefix extension test",
    "package": "npm --prefix extension run package",
    "openvsx:check": "npm --prefix extension run openvsx:check",
    "publish:ovsx": "npm --prefix extension run publish:ovsx",
    "install:extension": "npm --prefix extension install",
    "cli": "node cli/bin/auto-gitmoji.js",
    "hook:install": "node cli/bin/auto-gitmoji.js hook install",
    "hook:uninstall": "node cli/bin/auto-gitmoji.js hook uninstall"
  },
  "engines": {
    "node": ">=20"
  }
}
