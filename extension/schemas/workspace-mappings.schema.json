{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Auto Gitmoji project mappings",
  "definitions": {
    "mapping": {
      "type": "object",
      "required": ["keywords", "gitmoji"],
      "properties": {
        "keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gitmoji": {
          "type": "string",
          "minLength": 1,
          "description": "Emoji inserted for these keywords."
        },
        "code": {
          "type": "string",
          "pattern": "^:[a-zA-Z0-9_+-]+:$",
          "description": "Shortcode used when outputFormat is code."
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semver": {
          "enum": ["major", "minor", "patch", null]
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "array",
      "items": {
        "$ref": "#/definitions/mapping"
      }
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mapping"
          }
        },
        "customMappings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/mapping"
          }
        }
      },
      "anyOf": [
        {
          "required": ["mappings"]
        },
        {
          "required": ["customMappings"]
        }
      ],
      "additionalProperties": false
    }
  ]
}
